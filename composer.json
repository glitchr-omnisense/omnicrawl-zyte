{
    "name": "omnicrawl/zyte",
    "type": "library",
    "description": "Omnicrawl's Zyte API, under any PHP host: pages fetched over HTTP with the target's headers, behind omnicrawl's gate - and only for targets declared under a licence (one's own site, written permission), because Zyte's ban avoidance cannot be turned off and may override the User-Agent. No browser mode (it cannot send the family's User-Agent). Its limits and terms declared as data.",
    "keywords": [
        "zyte",
        "zyte-api",
        "scraping",
        "omnicrawl",
        "responsible",
        "framework-agnostic"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnicrawl-zyte",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnicrawl": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnicrawl\\Zyte\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnicrawl\\Zyte\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
